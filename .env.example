# 复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交进仓库）
# 用法（在 agent-from-scratch 目录下执行）：
#   Windows: copy .env.example .env
#   Mac/Linux: cp .env.example .env
# 填完真实密钥后运行：python -m afg.chat

# DeepSeek 的 API 密钥（在 platform.deepseek.com 申请）。
# config.py 里 api_key 字段通过 validation_alias 读这个变量名。
DEEPSEEK_API_KEY=your_api_key_here

# OpenAI 兼容端点的地址。默认 DeepSeek 官方；本机有中转网关时
# 可改成自己的地址（如 http://127.0.0.1:15721/v1）——改这里即可换供应商。
BASE_URL=https://api.deepseek.com

# 使用的模型名（DeepSeek 对话模型为 deepseek-chat）
MODEL=deepseek-chat

# 采样温度：0-2，越大回答越随机（config.py 的 LLMConfig.temperature 读它）
TEMPERATURE=0.7
